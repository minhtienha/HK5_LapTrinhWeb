@model List<ThietBiDienTu.Models.DonHang>

@{
    ViewBag.Title = "Danh Sách Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutNhanVien2.cshtml";
}

<h2>Danh Sách Đơn Hàng</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Khách Hàng</th>
                <th>Ngày Đặt</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dh in Model)
            {
                <tr>
                    <td>@dh.MaDonHang</td>
                    <td>@dh.KhachHang.HoTen</td>
                    <td>@(dh.NgayDat.ToString("yyyy-MM-dd"))</td>
                    <td>@string.Format("{0:N0} VND", dh.TongTien)</td>
                    <td>
                        @dh.TinhTrangGiaoHang
                        @using (Html.BeginForm("CapNhatTinhTrang", "NhanVien", FormMethod.Post))
                        {
                            @Html.Hidden("maDonHang", dh.MaDonHang)
                            <button type="submit" class="btn btn-warning btn-sm">Giao hàng</button>
                        }
                    </td>
                    <td>
                        @using (Html.BeginForm("XemChiTiet", "NhanVien", FormMethod.Get))
                        {
                            @Html.Hidden("maDonHang", dh.MaDonHang)
                            <button type="submit" class="btn btn-primary btn-sm">Xem Chi Tiết</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Không có đơn hàng nào.</p>
}
