@{
    ViewBag.Title = "NhieuAnhSanPham";
    Layout = "~/Views/Shared/_LayoutNhanVien2.cshtml";
}

<br />
<h4 class="text-danger">Ảnh hiện tại</h4>

<div class="row row-cols-4">
    @foreach (var item in ViewBag.dsHinhAnh)
    {
        <div class="col-3">
            <div class="card">
                @{
                    string imagePath = null;
                    string[] extensions = { ".jpg", ".png", ".jpeg" };
                    foreach (var ext in extensions)
                    {
                        var filePath = Server.MapPath("~/Content/HinhAnhSP/" + item + ext);
                        if (System.IO.File.Exists(filePath))
                        {
                            imagePath = Url.Content("~/Content/HinhAnhSP/" + item + ext);
                            break;
                        }
                    }
                }
                <img style="width: 100%; height: 190px" src="@imagePath" />
            </div>
            @using (Html.BeginForm("XoaHinhAnh", "NhanVien", FormMethod.Post))
            {
                <input type="hidden" name="id" value="@ViewBag.MaSP" />
                <input type="hidden" name="tenAnh" value="@item" />
                <button type="submit" class="btn btn-danger">Xoá</button>
            }
        </div>
    }
</div>
<br />
<h4>Thêm hình ảnh mới</h4>
@using (Html.BeginForm("ThemHinhAnh", "NhanVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        <label for="file">Chọn hình ảnh:</label>
        <input type="file" name="file" id="file" class="form-control" />
    </div>
    <input type="hidden" name="id" value="@ViewBag.MaSP" />

    <button type="submit" class="btn btn-success">Thêm hình ảnh</button>
}
<a href="@Url.Action("Index", "QuanLy")">Trở về</a>