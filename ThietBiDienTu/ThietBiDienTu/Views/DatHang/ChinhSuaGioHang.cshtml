@{
    ViewBag.Title = "ChinhSuaGioHang";
    Layout = "~/Views/Shared/_LayoutGioHang.cshtml";
}

<h2>Chỉnh Sửa Giỏ Hàng</h2>

<form action="@Url.Action("CapNhatGioHang", "DatHang")" method="post">
    <input type="hidden" name="maKH" value="@ViewBag.MaKH" />
    <table class="table">
        <thead>
            <tr>
                <th>STT</th>
                <th>Tên Sản Phẩm</th>
                <th>Hình Ảnh</th>
                <th>Số Lượng</th>
                <th>Đơn Giá</th>
                <th>Tổng</th>
                <th>Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@item.SanPham.TenSP</td>
                    <td>
                        <img src="/Content/HinhAnhSP/@(item.SanPham.HinhAnh + ".jpg")" alt="@item.SanPham.TenSP" style="width: 100px; height: 100px;" />
                    </td>
                    <td>
                        <input type="number" name="chiTietCapNhat[@i].SoLuong" value="@item.SoLuong" min="0" class="form-control" style="width: 70px;" />
                        <input type="hidden" name="chiTietCapNhat[@i].MaSP" value="@item.MaSP" />
                    </td>
                    <td>@string.Format("{0:N0} đ", item.SanPham.GiaBan)</td>
                    <td>@string.Format("{0:N0} đ", item.SoLuong * item.SanPham.GiaBan)</td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="this.closest('tr').querySelector('input[type=number]').value = 0;">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-right">
        <button type="submit" class="btn btn-primary">Lưu Giỏ Hàng</button>
        <a href="@Url.Action("XemGioHang", "DatHang", new { maKH = ViewBag.MaKH })" class="btn btn-secondary">Hủy Bỏ</a>
    </div>
</form>
