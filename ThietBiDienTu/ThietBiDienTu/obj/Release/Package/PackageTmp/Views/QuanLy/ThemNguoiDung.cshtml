@{
    ViewBag.Title = "Thêm Người Dùng";
}

<h2>Thêm Người Dùng</h2>

<form action="/QuanLy/ThemNguoiDung" method="post">
    <div>
        <label>Họ Tên:</label>
        <input type="text" name="HoTen" required />
    </div>
    <div>
        <label>Ngày Sinh:</label>
        <input type="date" name="NgaySinh" />
    </div>
    <div>
        <label>Giới Tính:</label>
        <select name="GioiTinh">
            <option value="Nam">Nam</option>
            <option value="Nữ">Nữ</option>
        </select>
    </div>
    <div>
        <label>Điện Thoại:</label>
        <input type="text" name="DienThoai" required />
    </div>
    <div>
        <label>Email:</label>
        <input type="email" name="Email" required />
    </div>
    <div>
        <label>Địa Chỉ:</label>
        <input type="text" name="DiaChi" />
    </div>
    <div>
        <label>Tài Khoản:</label>
        <input type="text" name="TaiKhoan" required />
    </div>
    <div>
        <label>Mật Khẩu:</label>
        <input type="password" name="MatKhau" required />
    </div>
    <div>
        <label>Loại Người Dùng:</label>
        <select name="LoaiNguoiDung" required>
            <option value="KhachHang">Khách Hàng</option>
            <option value="NhanVien">Nhân Viên</option>
        </select>
    </div>
    <div id="chucVuContainer" style="display: none;">
        <label>Chức Vụ:</label>
        <input type="text" name="ChucVu" />
    </div>
    <button type="submit">Thêm</button>
</form>

<script>
    document.querySelector('[name="LoaiNguoiDung"]').addEventListener('change', function () {
        const chucVuContainer = document.getElementById('chucVuContainer');
        chucVuContainer.style.display = this.value === 'NhanVien' ? 'block' : 'none';
    });
</script>