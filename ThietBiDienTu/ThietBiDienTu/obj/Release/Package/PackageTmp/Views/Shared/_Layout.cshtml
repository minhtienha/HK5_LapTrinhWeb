<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="~/Content/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/CSS/style.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    @*@Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")*@
    <title>@ViewBag.Title</title>

    <style>
        .footer-copy-right {
            background-color: #dfdfdf;
            padding: 14px 0;
        }

        .footer-copy-right p {
            font-size: 14px;
            text-align: center;
            margin: 0;
        }
    </style>
</head>
<body>
    <div id="header">
        <div class="container">
            <div class="header row d-flex">
                <div class="logo col-3">
                    <img style="width: 94%" src="/Content/HinhAnh/logoTanTien1.png" />
                </div>

                <form class="form-search col-5 d-flex align-items-center" action="/Home/trangSanPham" method="get">
                    <div class="head-search">
                        <input class="head-search-input" type="text" name="searchText" value="" placeholder="Bạn cần tìm gì?" />
                        <button type="submit" class="head-search-btn">
                            <span>
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <span>Tìm kiếm</span>
                        </button>
                    </div>
                </form>

                <div class="col-4 d-flex align-items-center justify-content-center text-white">
                    @if (Session["UserName"] != null)
                    {
                        <span>Xin chào, </span>
                        <a href="@Url.Action("thongTinNguoiDung", "DNDK", new { makh = Session["UserID"] })" class="text-white ml-2">
                            @Session["UserName"]
                            <i class="fa-regular fa-user"></i>
                        </a>
                        <span class="mx-2">/</span>
                        <a href="/DNDK/DangXuat" class="text-white">Đăng xuất</a>
                    }
                    else
                    {
                        <a href="/DNDK/DangNhap" class="text-white">
                            Đăng nhập
                        </a>
                        <span class="mx-2"> / </span>
                        <a href="/DNDK/DangKy" class="text-white">
                            Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
    <div id="navigation">
        <div class="container d-flex justify-content-center" style="height: 100%">
            <ul class="nav list-nav flex-row align-items-center">
                <li class="nav-item px-3 mx-3" style="height: 100%;">
                    <a href="/Home/Index">Trang chủ</a>
                </li>
                <li class="nav-item px-3 mx-3" style="height: 100%;">
                    <a href="/Home/trangSanPham">Sản phẩm</a>
                </li>
                <li class="nav-item px-3 mx-3" style="height: 100%;">
                    <a href="#">Liên hệ</a>
                </li>
                <li class="nav-item px-3 mx-3" style="height: 100%;">
                    <a href="/DatHang/XemGioHang?maKH=@Session["UserID"]">
                        Giỏ hàng
                        @if (Session["UserName"] != null)
                        {

                        }
                        else
                        {

                        }
                    </a>

                </li>
                <li class="nav-item px-3 mx-3" style="height: 100%;">
                    <a href="@Url.Action("lichSuDatHang", "DatHang", new { makh = Session["UserID"] })" class="nav-link">Lịch sử đặt hàng</a>
                </li>
            </ul>
        </div>
    </div>
    <div id="content" class="mt-3">
        <div class="container">
            @RenderBody()
        </div>
    </div>
    <div class="footer-copy-right">
        <div class="container">
            <p> © 2024. Nhóm 5.</p>
            <p>Địa chỉ: 140 Lê Trọng Tấn, P.Tây Thạnh, Q.Tân Phú, TP.Hồ Chí Minh.</p>
            <p>Điện thoại: 028 38125960. Email: nhom5@gmail.edu.vn.</p>
        </div>
    </div>
</body>
</html>
